pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        APP_DIR = 'DevOps-Project-33/DevSecOps-CI-CD-Pipeline'
    }

    stages {

        stage('Environment Check') {
            steps {
                sh '''
                    echo "===== Java ====="
                    java -version

                    echo "===== Maven ====="
                    mvn -version

                    echo "===== Git ====="
                    git --version
                '''
            }
        }

        stage('Compile') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn -B clean compile'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn -B test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            mvn -B \
                              org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                              -Dsonar.projectKey=project33-jpetstore \
                              -Dsonar.projectName=Project33-JPetStore
                        '''
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package WAR') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn -B package -DskipTests'
                    sh 'ls -lh target/jpetstore.war'
                }
            }
        }
    }

    post {
        success {
            echo 'Project 33 CI baseline completed successfully.'
        }

        failure {
            echo 'Project 33 CI baseline failed.'
        }

        always {
            junit allowEmptyResults: true,
                  testResults: 'DevOps-Project-33/DevSecOps-CI-CD-Pipeline/target/surefire-reports/*.xml'
        }
    }
}
